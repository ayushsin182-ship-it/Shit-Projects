{
  "manifest_version": 3,
  "name": "CP Lab \u2014 Open in VS Code",
  "version": "1.0.0",
  "description": "Solve in VS Code, check samples and submit using your logged-in judge tab. Local Mac mini project.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://codeforces.com/*",
    "https://atcoder.jp/*",
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CP Lab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://atcoder.jp/*",
        "https://leetcode.com/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "112"
}
